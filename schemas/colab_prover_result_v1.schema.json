{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "colab_prover_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "job_digest", "repository", "resolved_commit_sha", "status", "argv", "started_at", "finished_at", "elapsed_seconds", "exit_code", "runtime", "toolchain", "logs"],
  "properties": {
    "schema_version": {"const": "colab_prover_result_v1"},
    "job_id": {"type": "string"},
    "job_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"enum": ["chboishabba/dashi_lean4", "chboishabba/dashi_agda"]},
    "resolved_commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "status": {"enum": ["SUCCEEDED", "FAILED", "REJECTED", "ABORTED"]},
    "argv": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "exit_code": {"type": ["integer", "null"]},
    "runtime": {"type": "object"},
    "toolchain": {"type": "object"},
    "logs": {"type": "array", "items": {"type": "object"}}
  }
}
